# Copy to .env for local development. Never commit .env.
# Deployed environments read these from a secret manager.

# ── Azure DevOps (adapters/azure-devops) ─────────────────────────────────
# Organization URL, e.g. https://dev.azure.com/<organization>
AZURE_DEVOPS_ORG_URL=
AZURE_DEVOPS_PROJECT=
# Least-privilege token: work items read and write limited to what the lobe policy needs.
AZURE_DEVOPS_PAT=

# ── Agent Runtime (docs/adr/0004-agent-runtime-port-with-claude-and-copilot-backends.md) ──
# Credentials only: each lobe's backend and model are committed configuration, not variables.
# Tokens are personal: use your own subscriptions, never someone else's.
# Claude backend: subscription token from `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# Copilot backend: GitHub token for an account with a Copilot plan, used only for Copilot
# (not the token that pushes branches or opens PRs).
COPILOT_GITHUB_TOKEN=
# Optional fallback for the Claude backend: pay-as-you-go Anthropic API key.
# ANTHROPIC_API_KEY=
