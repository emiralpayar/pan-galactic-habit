# ─────────────────────────────────────────────────────────────────────────
# pan-galactic-x .gitignore
# Language-specific sections cover the likely candidates until the
# implementation language is chosen (ARCHITECTURE.md §11); prune afterwards.
# ─────────────────────────────────────────────────────────────────────────

# ── Secrets and local configuration ──────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/
credentials*.json
service-account*.json
.azure/
.npmrc
.pypirc

# ── Claude Code and AI agent local state ────────────────────────────────
.claude/settings.local.json
CLAUDE.local.md
.claude/worktrees/
# Local eval runs and agent transcripts (never commit real data)
.eval-results/
lobes/*/evals/results/
transcripts/
*.transcript.json

# ── Operating systems ────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~

# ── Editors and IDEs ─────────────────────────────────────────────────────
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*.sublime-workspace
.history/
.fleet/
.zed/

# ── Logs and temporary files ─────────────────────────────────────────────
*.log
logs/
tmp/
temp/
.tmp/
*.tmp
*.bak
*.orig
*.rej

# ── Build output and coverage (generic) ──────────────────────────────────
dist/
build/
out/
coverage/
*.lcov
.cache/

# ── Node.js / TypeScript ─────────────────────────────────────────────────
node_modules/
.pnpm-store/
.yarn/*
!.yarn/releases
!.yarn/plugins
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
.turbo/
.eslintcache

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# ── Go ───────────────────────────────────────────────────────────────────
/bin/
*.test
*.out
go.work.sum

# ── .NET ─────────────────────────────────────────────────────────────────
[Bb]in/
[Oo]bj/
*.user
*.suo
TestResults/

# ── Containers and infrastructure ────────────────────────────────────────
.docker/
docker-compose.override.yml
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
